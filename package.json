{
  "name": "clipboard-masker",
  "version": "1.0.0",
  "description": "Cross-Platform Clipboard Privacy & PII Protection Desktop Application",
  "private": true,
  "workspaces": [
    "packages/desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/desktop",
    "dev:web": "npm run dev:web --workspace=packages/desktop",
    "build": "npm run build --workspace=packages/desktop",
    "build:win": "npm run build:win --workspace=packages/desktop",
    "test": "npm run test --workspace=packages/desktop",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f"
  },
  "keywords": [
    "clipboard",
    "privacy",
    "pii",
    "security",
    "presidio",
    "gliner",
    "electron",
    "react"
  ],
  "author": "Clipboard Masker Contributors",
  "license": "UNLICENSED"
}
