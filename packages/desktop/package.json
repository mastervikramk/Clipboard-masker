{
  "name": "@clipboard-masker/desktop",
  "version": "1.0.0",
  "description": "Clipboard Masker Desktop App (Electron + React)",
  "author": "Clipboard Masker Contributors",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --config vite.config.web.ts",
    "icons": "node scripts/generate-icons.mjs",
    "bundle:model": "node scripts/bundle-model.mjs",
    "keyhelper": "node scripts/build-keyhelper.mjs",
    "build": "npm run icons && npm run bundle:model && tsc --noEmit && vite build && electron-builder --dir",
    "build:win": "npm run icons && npm run bundle:model && tsc --noEmit && vite build && electron-builder --win",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.47",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.1.4"
  }
}
